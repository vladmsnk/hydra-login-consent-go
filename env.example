# Server configuration
HOST=0.0.0.0
PORT=3000

# Hydra Admin API
# Use host.docker.internal to reach services on the host machine
HYDRA_ADMIN_URL=http://host.docker.internal:4445
HYDRA_USERNAME=adminuser
HYDRA_PASSWORD=changeme

# LDAP configuration
# Use host.docker.internal if OpenLDAP runs on the host
LDAP_SERVER=ldap://host.docker.internal:389
LDAP_BASE_DN=dc=desaidentity,dc=com
LDAP_BIND_DN=cn=admin,dc=desaidentity,dc=com
LDAP_BIND_PASSWORD=changeme
LDAP_USER_SEARCH_FILTER=(uid=%s)
LDAP_USE_TLS=false
LDAP_INSECURE_SKIP_TLS=false
LDAP_TIMEOUT=10s
